      Font.Height = -13
      Font.Name = 'Courier New'
      Font.Style = [fsBold]
    end
    object DivHazard: TCyberDivider
      Left = 0
      Height = 20
      Top = 300
      Width = 350
      Align = alTop
    end
    object MemDump: TCyberHexDump
      Left = 0
      Height = 200
      Top = 320
      Width = 350
      Align = alTop
      Font.Height = -12
      Font.Name = 'Courier New'
      Font.Style = [fsBold]
    end
    object KnobPower: TCyberKnob
      Left = 30
      Height = 80
      Top = 580
      Width = 80
      Font.Height = -13
      Font.Name = 'Courier New'
      Font.Style = [fsBold]
      OnChange = KnobPowerChange
    end
    object ProgShield: TCyberProgressBar
      Left = 130
      Height = 25
      Top = 605
